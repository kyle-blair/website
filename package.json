{
	"name": "zerofourtwo.com",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.22.1"
	},
	"scripts": {
		"dev": "bash scripts/dev.sh",
		"database:migrate": "node scripts/migrate-database.mjs",
		"build": "next build && cp -R .next/static .next/standalone/.next/static",
		"start": "node .next/standalone/server.js",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:verify": "prettier --check .",
		"test": "npm run test:unit && npm run test:integration",
		"test:no-cache": "INTEGRATION_BUILD_CACHE=0 npm test",
		"test:unit": "node --import ./test/support/typescript.ts --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/*Suite.ts\"",
		"test:integration": "INTEGRATION_BUILD_CACHE=${INTEGRATION_BUILD_CACHE:-1} bash scripts/integration.sh"
	},
	"dependencies": {
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/api-logs": "0.223.0",
		"@opentelemetry/exporter-logs-otlp-proto": "0.223.0",
		"@opentelemetry/exporter-metrics-otlp-proto": "0.223.0",
		"@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
		"@opentelemetry/instrumentation": "0.223.0",
		"@opentelemetry/instrumentation-pg": "0.76.0",
		"@opentelemetry/instrumentation-undici": "0.33.0",
		"@opentelemetry/resources": "2.12.0",
		"@opentelemetry/sdk-logs": "0.223.0",
		"@opentelemetry/sdk-metrics": "2.12.0",
		"@opentelemetry/sdk-trace": "2.12.0",
		"@opentelemetry/sdk-trace-base": "2.12.0",
		"@vercel/otel": "2.1.3",
		"lucide-react": "^1.46.0",
		"markdown-it": "^15.0.3",
		"next": "^16.4.2",
		"pg": "8.23.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@electric-sql/pglite": "0.5.10",
		"@types/jsdom": "30.0.0",
		"@types/node": "^24",
		"@types/pg": "8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.4.2",
		"jsdom": "30.1.3",
		"prettier": "^3.9.7",
		"typescript": "^6.0.3"
	}
}
