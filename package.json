{
	"name": "zerofourtwo.com",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.19.0"
	},
	"scripts": {
		"postinstall": "npm --prefix services/storage clean-install --include=dev",
		"dev": "bash scripts/dev.sh",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:verify": "prettier --check .",
		"test": "npm run test:unit && npm run test:integration",
		"test:cached": "bash -c \"export INTEGRATION_BUILD_CACHE=1; npm test\"",
		"test:unit": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100",
		"test:integration": "bash scripts/integration.sh"
	},
	"dependencies": {
		"lucide-react": "^1.46.0",
		"markdown-it": "^15.0.2",
		"next": "^16.3.5",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@types/jsdom": "30.0.0",
		"@types/node": "^24",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.3.5",
		"jsdom": "30.1.3",
		"prettier": "^3.9.7",
		"typescript": "^6.0.3"
	}
}
