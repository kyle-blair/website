FROM node:24.19.0-bookworm-slim
RUN apt-get update \
    && apt-get install --yes --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production PORT=10000
COPY services/storage/package.json services/storage/package-lock.json ./
RUN npm clean-install --omit=dev
COPY services/storage/src ./services/storage/src
COPY shared ./shared
USER node
EXPOSE 10000
CMD ["node", "--import", "./services/storage/src/instrumentation.ts", "services/storage/src/server.ts"]
